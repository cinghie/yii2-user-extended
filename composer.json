{
    "name": "cinghie/yii2-user-extended",
    "description": "Module to extend functionalities of Yii2 User by Dektrium.",
    "keywords": [
        "yii2 user extended",
        "yii2 user",
        "yii2 user management",
        "yii2 user field"
    ],
    "homepage": "https://github.com/cinghie/yii2-user-extended",
    "type": "yii2-extension",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Gogodigital.it",
            "email": "info@gogodigital.it",
            "homepage": "http://www.gogodigital.it/"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "yiisoft/yii2": "^2.0.47",
        "yiisoft/yii2-jui": "^2.0.7",
        "dektrium/yii2-user": "@dev",
        "dektrium/yii2-rbac": "@dev"
    },
    "require-dev": {
        "cinghie/yii2-traits": "@dev",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "cinghie\\userextended\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "cinghie\\userextended\\tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml"
    },
    "extra": {
        "bootstrap": "cinghie\\userextended\\Bootstrap"
    },
    "conflict": {
        "2amigos/yii2-usuario": "*"
    }
}
